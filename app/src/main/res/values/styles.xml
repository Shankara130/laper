<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Sudut gambar: hanya bagian atas yang membulat -->
    <style name="ShapeLaper.ImageTop" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/corner_card</item>
        <item name="cornerSizeTopRight">@dimen/corner_card</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- Sudut gambar: semua sisi membulat -->
    <style name="ShapeLaper.ImageAll" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <!-- Lingkaran penuh (avatar) -->
    <style name="ShapeLaper.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>
